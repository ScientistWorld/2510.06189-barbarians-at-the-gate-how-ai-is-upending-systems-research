    "complete_fraction": {
      "coefficient": 0.4,
      "description": "Fraction of required slice traces for which the method emitted a placement artifact; catches methods that skip difficult traces.",
      "higher_is_better": true
    },
    "family_imbalance_floor": {
      "coefficient": 0.25,
      "description": "Worst family-level mean load balance; catches methods tuned to one workload family while regressing on another.",
      "higher_is_better": true
    },
    "family_imbalance_spread": {
      "coefficient": -0.15,
      "description": "Gap between best and worst family-level mean load balance; penalizes uneven behavior across workload families.",
      "higher_is_better": false
    },
    "high_skew_mean_imbalance_factor": {
      "coefficient": 0.25,
      "description": "Mean load balance on the higher-skew half of the slice; catches methods that only handle easy load distributions.",
      "higher_is_better": true
    },
    "high_skew_mean_operation_count": {
      "coefficient": -0.1,
      "description": "Mean counted rebalance work on higher-skew traces; catches hidden work blowups on difficult load distributions.",
      "higher_is_better": false
    },
    "mean_imbalance_factor": {
      "coefficient": 0.5,
      "description": "Mean GPU load balance ratio across traces; preserves the paper's no-worse-load-balance constraint.",
      "higher_is_better": true
    },
    "mean_operation_count": {
      "coefficient": -0.2,
      "description": "Mean machine-independent rebalance work; penalizes improvements that only win by increasing counted work.",
      "higher_is_better": false
    },
    "min_imbalance_factor": {
      "coefficient": 0.3,
      "description": "Worst per-trace GPU load balance ratio on the slice; catches methods that keep the mean balanced while sacrificing hard cases.",
      "higher_is_better": true
    },
    "p95_operation_count": {
      "coefficient": -0.15,
      "description": "High-percentile rebalance work across traces; catches methods that hide rare expensive placements behind a good mean.",
      "higher_is_better": false
    },
    "valid_fraction": {
      "coefficient": 0.35,
